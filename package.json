{
  "name": "testes-vitest-prisma-express",
  "version": "1.0.0",
  "private": true,
  "description": "Atividade pratica de testes com Vitest, Supertest, Express e Prisma",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
